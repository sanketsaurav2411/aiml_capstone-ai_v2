APP_TITLE=TariffFlow AI - Indian Customs & Tariff Intelligence Service
APP_VERSION=2.0.0
APP_ENV=development
APP_PORT=8001

# Vector DB configuration (auto-resolves chroma_db_v0_3 -> chroma_db_base_64_v0.73 -> chroma_db_small_256_v0.71)
VECTOR_DB_BASE_URL=
CHROMA_PERSIST_DIR=
GCS_CHROMA_SNAPSHOT_URI=
DEFAULT_COLLECTION=itc_tariff_items
DEFAULT_TOP_K=5
EMBED_MODEL_NAME=BAAI/bge-base-en-v1.5
ENABLE_LOCAL_EMBEDDINGS=false

# LLM & Persistence
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
SQLITE_DB_PATH=./data/ai_sessions.sqlite
DATABASE_URL=

# Security & Guardrails
INTERNAL_API_KEY=
ALLOWED_ORIGINS=http://localhost:4000,http://localhost:5173
TARIFF_VERSION=ITC-HS 2022 (DGCI&S Schedule I, effective 1 April 2022)
ABSTENTION_CONFIDENCE_THRESHOLD=0.65
ABSTENTION_SIMILARITY_THRESHOLD=0.20
